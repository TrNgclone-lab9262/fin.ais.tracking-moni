  useEffect(() => {
    if (isOpen) {
      setType("EXPENSE");
      setNumericAmount(0);
      setNote("");
      setError(null);

      if (activePerspective === "WIFE") {
        setMemberId("WIFE");
      } else {
        setMemberId("HUSBAND");
      }

      const preferredAccount =
        activePerspective === "WIFE"
          ? accounts.find((a) => a.owner === "WIFE") || accounts[0]
          : accounts.find((a) => a.owner === "HUSBAND") || accounts[0];

      if (preferredAccount) {
        setAccountId(preferredAccount.id);
      }
