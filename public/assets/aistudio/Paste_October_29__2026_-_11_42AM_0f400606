        amount: numericAmount,
        date: new Date().toISOString().split("T")[0],
        type,
        categoryId: categoryId || "cat_food",
        accountId: accountId || accounts[0]?.id || "acc_husband_vietinbank",
        memberId,
        scope,
        note: note.trim() || undefined,
