                key={d.day}
                title={`Ngày ${d.day}/10: ${d.amount > 0 ? formatVND(d.amount) : "Không chi tiêu"}`}
                className={`h-8 rounded-md flex flex-col items-center justify-center text-xs transition-transform hover:scale-105 cursor-pointer ${bgClass}`}
              >
